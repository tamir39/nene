# Hosted sandbox demo (Render + Supabase cloud). Variable names only.
# Set real values in the Render dashboard; never commit them. See docs/HOSTED_DEMO.md.
NODE_ENV=production
DEMO_DEPLOYMENT=hosted-sandbox
HOST=0.0.0.0
NODE_VERSION=24
# PORT is supplied by Render.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Session pooler (port 5432) with the restricted role, not postgres.
DATABASE_URL=postgresql://nene_api.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=certs/supabase-root-2021.crt

# Each feature stays off until its flag is true and its database setting is seeded.
LOCAL_TRANSFERS_ENABLED=true
LOCAL_CASH_ENABLED=true
LOCAL_INTERBANK_ENABLED=true

# High-value transfer face checks (docs/LOCAL_TRANSFERS.md). The first two are
# needed at build time too: skip the CUDA download and limit glibc arenas.
ONNXRUNTIME_NODE_INSTALL=skip
MALLOC_ARENA_MAX=2
# Optional cosine-similarity threshold; defaults to 0.40.
FACE_MATCH_THRESHOLD=

# Leave false until VNPay sandbox credentials exist.
VNPAY_SANDBOX_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://<render-service>.onrender.com/api/v1/payments/vnpay/return

# Optional assistant AI fallback (docs/ASSISTANT.md). The key is needed only when true.
ASSISTANT_AI_ENABLED=false
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite. gemini-3.1-flash-lite is tried once as a backup.
GEMINI_MODEL=
