# Copy to .env after starting local Supabase. Keep actual credentials untracked.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Use the local Supabase URL and publishable (or legacy anon) key from its status.
# The optional backend-only secret/service-role key enables officer provisioning.
# Never put it in the Flutter configuration or source control.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Use the restricted nene_api role provisioned using infrastructure instructions.
# URI-encode reserved characters in the password. Do not use the postgres owner.
DATABASE_URL=postgresql://nene_api:replace_with_local_password@127.0.0.1:54322/postgres
# disable is permitted only for loopback PostgreSQL outside production.
# For hosted PostgreSQL choose verify-full; certificate verification stays enabled.
DATABASE_SSL_MODE=disable
# Optional path to the provider CA PEM, if its certificate needs a custom CA.
DATABASE_SSL_CA_FILE=
