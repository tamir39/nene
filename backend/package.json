{
  "name": "nene-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS foundation for the Nene course project",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start:dev": "npm run build && concurrently --kill-others \"npm:build:watch\" \"node --watch dist/main.js\"",
    "lint": "eslint src test",
    "format:check": "prettier --check src test *.json *.mjs README.md",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/test/*.spec.js\"",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@supabase/supabase-js": "2.117.3",
    "dotenv": "18.0.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
